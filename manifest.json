{
  "manifest_version": 3,
  "name": "Busca mensaxes Abalar",
  "version": "1.0.3",
  "description": "Cachea todas as páxinas da listaxe de mensaxes de Abalar e permite buscar as mensaxes por nome de alumno/a (total ou parcial).",
  "permissions": ["storage"],
  "browser_specific_settings": {
    "gecko": {
      "id": "busca_mensaxes_abalar@penalta.es",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.edu.xunta.gal/abalar/ListarMensaxesBandexa.do*",
        "*://*/abalar/ListarMensaxesBandexa.do*"
      ],
      "js": ["content/abalar.js"],
      "css": ["content/abalar.css"],
      "run_at": "document_idle"
    }
  ]
}